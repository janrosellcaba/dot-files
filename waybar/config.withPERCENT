{
  "position": "top",
  "height": 27,
  "spacing": 4,

  "modules-left": ["hyprland/workspaces"],
  "modules-right": [
    "mpris",
    "group/hardware",
    "backlight",
    "pulseaudio",
    "network",
    "battery",
    "clock"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace m+1",
    "on-scroll-down": "hyprctl dispatch workspace m-1"
  },

  "mpris": {
    "format": "{player_icon} {title} - {artist}",
    "format-paused": "{status_icon} <i>{title} - {artist}</i>",
    "max-length": 40,
    "player-icons": {
      "default": "▶",
      "spotify": "",
      "firefox": ""
    },
    "status-icons": {
      "playing": "▶",
      "paused": "⏸"
    },
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  "group/hardware": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false,
      "click-to-reveal": true
    },
    "modules": ["cpu", "memory", "temperature"]
  },

  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "tooltip": true
  },

  "memory": {
    "interval": 5,
    "format": " {used:0.1f}GiB"
  },

  /*"temperature": {
    "interval": 3,
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["", "", ""]
  },*/

  "temperature": {
    "interval": 1,
    "hwmon-path": "/sys/class/hwmon/hwmon5/temp1_input",
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["", "", ""]
  },

  "backlight": {
    "format": "{percent}% {icon}",
    "format-icons": ["", "", "", "", "", "", "", "", ""]
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{capacity}% {icon}",
    "format-icons": ["", "", "", "", ""]
  },

  "network": {
    "format-wifi": "{essid} ",
    "format-disconnected": "Disconnected ⚠",
    "tooltip-format": "  {essid} ({signalStrength}%)\n⇣ {bandwidthDownBytes}  ⇡ {bandwidthUpBytes}",
    "interval": 2
  },

  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon}",
    "format-muted": "Muted ",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },

  "clock": {
    "interval": 1,
    "format": " {:%b %d %H:%M:%S} ",
    "tooltip-format": "<span font='JetBrainsMono Nerd Font 11'><tt>{calendar}</tt></span>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "none",
      "on-scroll": 1,
      "n-months": 2,
      "col-months": 2,
      "format": {
        "months": "<span color='#ffffff'><b>{}</b></span>",
        "days": "<span color='#a5adcb'>{}</span>",
        "weekdays": "<span color='#7c818c'><b>{}</b></span>",
        "today": "<span color='#ffffff' background='#264733'><b> {} </b></span>"
      }
    }
  }
}
